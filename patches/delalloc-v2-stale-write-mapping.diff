# Delalloc series v2, on top of v1 (patches 1-7): a buffered write's
# delalloc mapping goes stale when a write fault or writeback allocates its
# clusters; ->iomap_valid() notices it, ->iomap_end() releases what was not
# copied and the rest is mapped again (tests/stale_write_mapping.sh).

diff --git a/fs/ntfs/attrib.c b/fs/ntfs/attrib.c
index 7c19e4534a..3e20ace211 100644
--- a/fs/ntfs/attrib.c
+++ b/fs/ntfs/attrib.c
@@ -5626,6 +5626,8 @@ int ntfs_attr_map_cluster(struct ntfs_inode *ni, s64 vcn_start, s64 *lcn_start,
 	}
 	ni->runlist.rl = rl;
 	ni->runlist.count = new_rl_count;
+	/* Delalloc mappings of buffered writes in flight go stale. */
+	WRITE_ONCE(ni->alloc_seq, ni->alloc_seq + 1);
 
 	if (!update_mp) {
 		u64 free = atomic64_read(&vol->free_clusters) * 100;
