+static int ntfs_dio_read_boundary(struct inode *inode, loff_t offset,
+		loff_t initialized_size, unsigned int flags, struct iomap *iomap)
+{
+	struct folio *folio;
+	size_t valid = initialized_size - offset;
+	unsigned int nofs_flags;
+	void *data;
+
+	if (flags & IOMAP_NOWAIT)
+		return -EAGAIN;
+
+	data = kzalloc(i_blocksize(inode), GFP_NOFS);
+	if (!data)
+		return -ENOMEM;
+
+	/* Copy a masked boundary block without exposing its uninitialized tail. */
+	filemap_invalidate_lock_shared(inode->i_mapping);
+retry:
+	nofs_flags = memalloc_nofs_save();
+	folio = read_mapping_folio(inode->i_mapping, offset >> PAGE_SHIFT, NULL);
+	memalloc_nofs_restore(nofs_flags);
+	if (IS_ERR(folio)) {
+		filemap_invalidate_unlock_shared(inode->i_mapping);
+		kfree(data);
+		return PTR_ERR(folio);
+	}
+
+	folio_lock(folio);
+	if (folio->mapping != inode->i_mapping) {
+		folio_unlock(folio);
+		folio_put(folio);
+		goto retry;
+	}
+	memcpy_from_folio(data, folio, offset_in_folio(folio, offset), valid);
+	folio_unlock(folio);
+	folio_put(folio);
+	filemap_invalidate_unlock_shared(inode->i_mapping);
+
+	iomap->type = IOMAP_INLINE;
+	iomap->addr = IOMAP_NULL_ADDR;
+	iomap->inline_data = data;
+	iomap->private = data;
+	iomap->offset = offset;
+	iomap->length = i_blocksize(inode);
+	return 0;
+}
